<Window x:Class="AutomataSimulator.WPF.Windows.ManualConstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ручной конструктор автомата" Height="600" Width="800" WindowStartupLocation="CenterOwner" Background="#ECF0F1">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: Множества -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Математическая модель" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Тип автомата:"/>
            <ComboBox ItemsSource="{Binding AutomatonTypes}" SelectedItem="{Binding SelectedType}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Множество состояний (Q):"/>
            <TextBox Text="{Binding StatesText}" Margin="0,0,0,10" Padding="5" ToolTip="Через запятую: q0, q1, q2"/>

            <TextBlock Text="Алфавит (Σ):"/>
            <TextBox Text="{Binding AlphabetText}" Margin="0,0,0,10" Padding="5" ToolTip="Через запятую: a, b, c"/>

            <StackPanel Visibility="{Binding IsPda, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Алфавит магазина (Γ):"/>
                <TextBox Text="{Binding StackAlphabetText}" Margin="0,0,0,10" Padding="5"/>
            </StackPanel>

            <TextBlock Text="Начальное состояние (q0):"/>
            <TextBox Text="{Binding StartStateText}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Финальные состояния (F):"/>
            <TextBox Text="{Binding FinalStatesText}" Margin="0,0,0,10" Padding="5"/>
        </StackPanel>

        <!-- Правая часть: Переходы -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Функция переходов (δ)" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBlock Grid.Row="1" Foreground="#7F8C8D" Margin="0,0,0,10" TextWrapping="Wrap">
                <Run Text="Для DFA/NFA формат:" FontWeight="Bold"/> Откуда, Символ -> Куда<LineBreak/>
                <Run Text="Для PDA формат:" FontWeight="Bold"/> Откуда, Вход, СнятьСтек -> Куда, ПоложитьВСтек<LineBreak/>
                <Run Text="* ε (эпсилон) записывается как 'eps' или 'ε'." Foreground="#E74C3C"/>
            </TextBlock>

            <TextBox Grid.Row="2" Text="{Binding TransitionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas" FontSize="14" Padding="5"/>

            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="СОЗДАТЬ АВТОМАТ" Click="Build_Click" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>